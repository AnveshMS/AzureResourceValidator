# Azure Configuration
# Copy this file to .env and fill in your actual values

# Azure Subscription ID (required)
AZURE_SUBSCRIPTION_ID=your-subscription-id-here

# Azure Resource Group (required)
AZURE_RESOURCE_GROUP=your-resource-group-name-here

# Optional: Path to input CSV file
# If not specified, uses first CSV found in input/ folder
# AZURE_RES_INPUT_CSV=input/Expected_AzureScale.csv

# Optional: Path to output CSV report file
# If not specified, defaults to output/azure_scale_validation_output.csv
# AZURE_RES_OUTPUT_CSV=output/azure_scale_validation_output.csv
